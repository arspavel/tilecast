# Tilecast settings for a server without Internet access.
# install.sh creates .env from this file on the first run and fills in the
# passwords and the server address. Edit .env, then run install.sh again.

# Image version from the bundle. install.sh sets it.
TILECAST_IMAGE_TAG=

# true: the server never reaches the Internet (GitHub releases, public Data
# Sources, NWS alerts). false: Internet access is allowed and the switch
# "Работать без интернета" in Studio (Settings > System) decides.
# Apply a change with: docker compose up -d
TILECAST_OFFLINE=true

# Corporate proxy, when the network reaches the Internet only through one,
# for example http://proxy.corp.local:3128. Leave empty otherwise.
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1,postgres

# Address that screens and browsers use to reach this server, for example
# http://10.0.5.20:8080 or https://tilecast.corp.local when a reverse proxy
# with a corporate certificate is in front of it.
TILECAST_PUBLIC_URL=
TILECAST_PORT=8080
# 0.0.0.0 publishes the port on every interface. Use 127.0.0.1 only when a
# reverse proxy on this host serves Tilecast.
TILECAST_BIND_ADDRESS=0.0.0.0
# true only when Studio is opened over HTTPS.
TILECAST_COOKIE_SECURE=false

POSTGRES_DB=tilecast
POSTGRES_USER=tilecast
POSTGRES_PASSWORD=

TILECAST_LOG_LEVEL=info
TILECAST_SESSION_TTL=24h
TILECAST_PRESENTATION_NETWORK_KEY=

# Corporate websites and data sources are on private addresses.
TILECAST_WEBSITE_ALLOW_PRIVATE_HTTP=true
TILECAST_SOURCE_ALLOW_PRIVATE_NETWORKS=true

# Mail server inside the corporate network, if notifications are needed.
TILECAST_SMTP_HOST=
TILECAST_SMTP_PORT=587
TILECAST_SMTP_USERNAME=
TILECAST_SMTP_PASSWORD=
TILECAST_SMTP_TLS=starttls

# Largest media upload in bytes (default 10 GiB).
TILECAST_MAX_UPLOAD_BYTES=
